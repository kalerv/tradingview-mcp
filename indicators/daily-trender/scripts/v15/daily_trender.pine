//@version=6
// daily-trender v15.0.0 — based on v14.1.0 / v13.0.0-rc2
// Path: indicators/daily-trender/scripts/v15/daily_trender.pine

indicator("Relative Strength vs Benchmark (Table)", overlay = true, behind_chart = false)

// =========================================================================
// INPUTS — Benchmark
// display.none hides values from status line / Data Window (Inputs tab unchanged)
// =========================================================================
benchmarkPreset = input.string("QQQ", "Benchmark", options = ["QQQ", "SPY", "SMH", "IWM", "Custom"], group = "Benchmark", display = display.none)
benchmarkCustom = input.symbol("QQQ", "Custom Benchmark (used if 'Custom' selected above)", group = "Benchmark", display = display.none)
benchmarkSym    = benchmarkPreset == "Custom" ? benchmarkCustom : benchmarkPreset

// =========================================================================
// INPUTS — Settings
// =========================================================================
maxSymbols     = input.int(10, "Max symbols to fetch", minval = 1, maxval = 18, group = "Settings",
     tooltip = "Caps how many enabled tickers appear in the table. All 18 slots are still requested at global scope (Pine CW10003).", display = display.none)
sortByStrength = input.bool(true, "Sort strongest → top, weakest → bottom", group = "Settings")
sortMetric     = input.string("RS vs benchmark", "Sort by",
     options = ["RS vs benchmark", "Open % since RTH open"], group = "Settings",
     tooltip = "RS = Open % minus benchmark Open %. Matches the RS column.", display = display.none)
scoreWithRanges = input.bool(false, "Score with PrevD / PreMkt ranges", group = "Settings",
     tooltip = "When on, sort prioritizes tickers Above previous-day and/or pre-market ranges, then RS/Open %. Above+Above ranks above faster movers still Inside. Default off = RS/Open % only.")
showBeforeRthOpen = input.bool(false, "Show table before RTH open (premarket)", group = "Settings",
     tooltip = "Off (default): table appears after 9:30 when Open % is available. On: show rows in premarket using price / Mov / PrevD / PreMkt; Open % and RS show — until the open. Sort falls back to Mov until RTH.")
theme          = input.string("Dark", "Table Theme", options = ["Dark", "Light"], group = "Settings", display = display.none)
sessionTz      = input.string("America/New_York", "Session Timezone", group = "Settings", display = display.none)

posInput = input.string("Top Right", "Table Position",
     options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = "Settings", display = display.none)

textSize = input.string("Small", "Table Text Size", options = ["Tiny", "Small", "Normal", "Large"], group = "Settings", display = display.none)

// =========================================================================
// INPUTS — Table columns
// =========================================================================
gCols = "Table Columns"
showBenchRow = input.bool(true,  "Show pinned benchmark row", group = gCols)
showMov      = input.bool(true,  "Show Mov (% vs prior close)", group = gCols)
showOpen     = input.bool(true,  "Show Open (% since RTH open)", group = gCols)
showBenchCol = input.bool(true,  "Show Benchmark % column", group = gCols)
showRS       = input.bool(true,  "Show RS (relative strength)", group = gCols)
showTrend    = input.bool(true,  "Show Trend (alignment)", group = gCols,
     tooltip = "Long/Short when PrevD + PreMkt + RS align (3/3 = strong, 2/3 = developing). Flat when mixed.")
showYTrend   = input.bool(true,  "Show YTrend (yesterday vs prior range)", group = gCols)

gAdx = "ADX Settings"
showADX           = input.bool(true,  "Show ADX", group = gAdx)
colorADX          = input.bool(true,  "Color ADX", group = gAdx)
adxTFInput        = input.string("Chart", "Time Frame to Use", options = ["Chart"], group = gAdx,
     tooltip = "ADX is calculated on the chart timeframe for each symbol (required for Pine multi-symbol consistency).", display = display.none)
adxThreshold      = input.float(25.0, "ADX Threshold", minval = 5, maxval = 50, step = 1, group = gAdx,
     tooltip = "Strong trend boundary + alert level. Default 25.", display = display.none)
adxAlertEnabled   = input.bool(false, "Alert when ADX above configured Threshold?", group = gAdx)
alertSession      = input.session("0930-1600", "Alert Period", group = gAdx, display = display.none)
adxFilterEnabled  = input.bool(false, "Filter stocks with ADX (>) above?", group = gAdx)
adxFilterAbove    = input.float(20.0, "ADX filter minimum", minval = 5, maxval = 40, step = 1, group = gAdx,
     tooltip = "Only show rows with ADX above this when filter is enabled. Default 20.", display = display.none)
adxLen            = input.int(14, "ADX length", minval = 1, group = gAdx, display = display.none)
adxSmooth         = input.int(14, "ADX smoothing", minval = 1, group = gAdx, display = display.none)

gPrevD = "Previous Day Settings"
showPrevD          = input.bool(true, "Show Previous Day", group = gPrevD)
colorPrevD         = input.bool(true, "Color Previous Day", group = gPrevD)
prevDFilterEnabled = input.bool(false, "Filter Previous Day", group = gPrevD)
prevDFilter        = input.string("Above", "Previous Day filter", options = ["Above", "Below", "Inside"], group = gPrevD, display = display.none)

gPreMkt = "Pre Market Settings"
showPreMkt          = input.bool(true, "Show Pre-Market", group = gPreMkt)
colorPreMkt         = input.bool(true, "Color Pre-Market", group = gPreMkt)
preMktFilterEnabled = input.bool(false, "Filter Pre-Market", group = gPreMkt)
preMktFilter        = input.string("Above", "Pre-Market filter", options = ["Above", "Below", "Inside"], group = gPreMkt, display = display.none)

gOrb = "ORB Settings"
showOrb          = input.bool(true, "Show ORB", group = gOrb,
     tooltip = "Above / Below / Inside vs the selected opening-range high/low from 9:30 ET.")
colorOrb         = input.bool(true, "Color ORB", group = gOrb)
orbMinutes       = input.string("5", "ORB minutes", options = ["5", "15", "30"], group = gOrb,
     tooltip = "Only one ORB window is active. 5 = 09:30–09:35, 15 = 09:30–09:45, 30 = 09:30–10:00 ET.", display = display.none)
orbFilterEnabled = input.bool(false, "Filter ORB", group = gOrb)
orbFilter        = input.string("Above", "ORB filter", options = ["Above", "Below", "Inside"], group = gOrb, display = display.none)

gRvol = "RVOL Settings"
showRVOL         = input.bool(true,  "Show RVOL", group = gRvol)
colorRVOL        = input.bool(true,  "Color RVOL", group = gRvol)
rvolLen          = input.int(14, "Volume Average Length", minval = 2, group = gRvol,
     tooltip = "Bar RVOL = volume / SMA(volume, length) on chart TF.", display = display.none)
rvolThreshold    = input.float(2.0, "RVOL Threshold (high)", minval = 1.0, maxval = 5.0, step = 0.1, group = gRvol, display = display.none)
rvolLowThreshold = input.float(1.0, "RVOL low (weak)", minval = 0.1, maxval = 2.0, step = 0.1, group = gRvol,
     tooltip = "At or below: red (low participation).", display = display.none)

gLvl = "Level Columns"
showPDH  = input.bool(false, "Show PDH (prior day high)",  group = gLvl)
showPDL  = input.bool(false, "Show PDL (prior day low)",   group = gLvl)
showPMH  = input.bool(true,  "Show PMH (premarket high)", group = gLvl)
showPML  = input.bool(true,  "Show PML (premarket low)",  group = gLvl)
show5mH  = input.bool(true,  "Show 5m High (9:30–9:35)",  group = gLvl)
show5mL  = input.bool(true,  "Show 5m Low (9:30–9:35)",   group = gLvl)

needYTrend = showYTrend
needAdx    = showADX or adxFilterEnabled or adxAlertEnabled
needRvol   = showRVOL
// Note: separate ADX timeframe requests were removed (CW10003 — ta.dmi UDF inside symbol loop).
orbSession = orbMinutes == "5" ? "0930-0935:23456" : orbMinutes == "15" ? "0930-0945:23456" : "0930-1000:23456"
orbHeader  = "ORB" + orbMinutes

// =========================================================================
// INPUTS — Tickers (uncheck Enable to drop a slot without clearing the symbol)
// =========================================================================
g = "Tickers"
useSym1  = input.bool(true, "On", group = g, inline = "t1")
sym1     = input.symbol("AAPL", "Ticker 1", group = g, inline = "t1", display = display.none)
useSym2  = input.bool(true, "On", group = g, inline = "t2")
sym2     = input.symbol("AMD", "Ticker 2", group = g, inline = "t2", display = display.none)
useSym3  = input.bool(true, "On", group = g, inline = "t3")
sym3     = input.symbol("AMZN", "Ticker 3", group = g, inline = "t3", display = display.none)
useSym4  = input.bool(true, "On", group = g, inline = "t4")
sym4     = input.symbol("PLTR", "Ticker 4", group = g, inline = "t4", display = display.none)
useSym5  = input.bool(true, "On", group = g, inline = "t5")
sym5     = input.symbol("TSLA", "Ticker 5", group = g, inline = "t5", display = display.none)
useSym6  = input.bool(true, "On", group = g, inline = "t6")
sym6     = input.symbol("SPCX", "Ticker 6", group = g, inline = "t6", display = display.none)
useSym7  = input.bool(true, "On", group = g, inline = "t7")
sym7     = input.symbol("NVDA", "Ticker 7", group = g, inline = "t7", display = display.none)
useSym8  = input.bool(true, "On", group = g, inline = "t8")
sym8     = input.symbol("MU", "Ticker 8", group = g, inline = "t8", display = display.none)
useSym9  = input.bool(true, "On", group = g, inline = "t9")
sym9     = input.symbol("BATS:SNDK", "Ticker 9", group = g, inline = "t9", tooltip = "Use the same exchange prefix as your chart", display = display.none)
useSym10 = input.bool(true, "On", group = g, inline = "t10")
sym10    = input.symbol("HOOD", "Ticker 10", group = g, inline = "t10", display = display.none)
useSym11 = input.bool(true, "On", group = g, inline = "t11")
sym11    = input.symbol("MRVL", "Ticker 11", group = g, inline = "t11", display = display.none)
useSym12 = input.bool(true, "On", group = g, inline = "t12")
sym12    = input.symbol("CRDO", "Ticker 12", group = g, inline = "t12", display = display.none)
useSym13 = input.bool(true, "On", group = g, inline = "t13")
sym13    = input.symbol("MSFT", "Ticker 13", group = g, inline = "t13", display = display.none)
useSym14 = input.bool(true, "On", group = g, inline = "t14")
sym14    = input.symbol("GOOG", "Ticker 14", group = g, inline = "t14", display = display.none)
useSym15 = input.bool(true, "On", group = g, inline = "t15")
sym15    = input.symbol("MSTR", "Ticker 15", group = g, inline = "t15", display = display.none)
useSym16 = input.bool(true, "On", group = g, inline = "t16")
sym16    = input.symbol("AVGO", "Ticker 16", group = g, inline = "t16", display = display.none)
useSym17 = input.bool(true, "On", group = g, inline = "t17")
sym17    = input.symbol("", "Ticker 17 (optional)", group = g, inline = "t17", display = display.none)
useSym18 = input.bool(true, "On", group = g, inline = "t18")
sym18    = input.symbol("", "Ticker 18 (optional)", group = g, inline = "t18", display = display.none)

// =========================================================================
// THEME COLORS
// =========================================================================
bgMain     = theme == "Dark" ? color.new(color.black, 0) : color.new(color.white, 0)
bgHeader   = theme == "Dark" ? color.new(#2a2e39, 0) : color.new(#e0e3eb, 0)
bgBenchRow = theme == "Dark" ? color.new(#1a3a5c, 0) : color.new(#cfe3fa, 0)
txtMain    = theme == "Dark" ? color.white : color.black
neutralBg  = theme == "Dark" ? color.new(color.gray, 50) : color.new(color.gray, 75)
posColor   = color.new(#26a69a, 0)
negColor   = color.new(#ef5350, 0)
warnBg     = color.new(#f59e0b, 0)
bullAdxBg  = color.new(color.green, 0)
bearAdxBg  = color.new(color.red, 0)
weakAdxBg  = color.new(#9e9e9e, 0)

totalCols = 1 +
     (showMov ? 1 : 0) + (showOpen ? 1 : 0) + (showBenchCol ? 1 : 0) + (showRS ? 1 : 0) +
     (showPrevD ? 1 : 0) + (showPreMkt ? 1 : 0) + (showOrb ? 1 : 0) + (showTrend ? 1 : 0) + (showYTrend ? 1 : 0) +
     (showADX ? 1 : 0) + (showRVOL ? 1 : 0) +
     (showPDH ? 1 : 0) + (showPDL ? 1 : 0) + (showPMH ? 1 : 0) + (showPML ? 1 : 0) +
     (show5mH ? 1 : 0) + (show5mL ? 1 : 0)

// =========================================================================
// BUILD SYMBOL LIST (enabled + non-empty, capped by maxSymbols) + slot index
// =========================================================================
allSyms = array.from(sym1, sym2, sym3, sym4, sym5, sym6, sym7, sym8, sym9, sym10, sym11, sym12, sym13, sym14, sym15, sym16, sym17, sym18)
allUse  = array.from(useSym1, useSym2, useSym3, useSym4, useSym5, useSym6, useSym7, useSym8, useSym9, useSym10, useSym11, useSym12, useSym13, useSym14, useSym15, useSym16, useSym17, useSym18)

var string[] symbolList = array.new<string>()
var int[]    slotIdxArr = array.new<int>()
array.clear(symbolList)
array.clear(slotIdxArr)
for i = 0 to array.size(allSyms) - 1
    if array.get(allUse, i)
        t = str.upper(str.trim(array.get(allSyms, i)))
        if t != "" and not array.includes(symbolList, t) and array.size(symbolList) < maxSymbols
            array.push(symbolList, t)
            array.push(slotIdxArr, i)

n = array.size(symbolList)

f_shortSymbol(full) =>
    parts = str.split(full, ":")
    array.size(parts) > 1 ? array.get(parts, 1) : full

f_fmtPrice(v) =>
    na(v) ? "—" : str.tostring(v, "#.##")

f_fmtAdx(adx, pdi, mdi) =>
    if na(adx)
        "—"
    else if not na(pdi) and not na(mdi) and adx >= adxThreshold
        str.tostring(adx, "#.#") + (pdi > mdi ? " ▲" : pdi < mdi ? " ▼" : "")
    else
        str.tostring(adx, "#.#")

f_fmtRvol(v) =>
    na(v) ? "—" : str.tostring(v, "#.#") + "x"

f_rangeLabel(price, rangeHigh, rangeLow) =>
    na(price) or na(rangeHigh) or na(rangeLow) ? "—" : price > rangeHigh ? "Above" : price < rangeLow ? "Below" : "Inside"

f_adxBg(adx, pdi, mdi) =>
    if na(adx)
        neutralBg
    else if adx < adxFilterAbove
        weakAdxBg
    else if adx < adxThreshold
        warnBg
    else if not na(pdi) and not na(mdi) and pdi > mdi
        bullAdxBg
    else if not na(pdi) and not na(mdi) and pdi < mdi
        bearAdxBg
    else
        warnBg

f_rvolBg(v) =>
    na(v) ? neutralBg : v >= rvolThreshold ? bullAdxBg : v <= rvolLowThreshold ? bearAdxBg : neutralBg

// =========================================================================
// Combined intraday bundle — evaluated only via global-scope request.security (CW10003).
// =========================================================================
f_symbolBundle(adxL, adxSm, rvolL, calcAdx, calcRvol, calcYt) =>
    var float pdh = na
    var float pdl = na
    var float sessH = na
    var float sessL = na
    var float dayOpen = na
    var float prevClose = na
    var float lastRTHClose = na
    var float pmH = na
    var float pmL = na
    var float fiveH = na
    var float fiveL = na
    var float orbH = na
    var float orbL = na
    var float ppdh = na
    var float ppdl = na
    var float yClose = na
    var string ytLbl = "—"

    bool inPM     = not na(time(timeframe.period, "0400-0930:23456", sessionTz))
    bool inRTH    = not na(time(timeframe.period, "0930-1600:23456", sessionTz))
    bool inFirst5 = not na(time("5", "0930-0935:23456", sessionTz))
    bool inOrbWin = not na(time(timeframe.period, orbSession, sessionTz))
    bool rthStart = inRTH and not inRTH[1]
    bool newDay   = ta.change(time("D")) != 0

    if newDay
        if calcYt
            ppdh := pdh
            ppdl := pdl
            if not na(lastRTHClose)
                yClose := lastRTHClose
            ytLbl := na(yClose) or na(ppdh) or na(ppdl) ? "—" : yClose > ppdh ? "Above" : yClose < ppdl ? "Below" : "Inside"
        if not na(sessH)
            pdh := sessH
            pdl := sessL
        if not na(lastRTHClose)
            prevClose := lastRTHClose
        sessH := na
        sessL := na
        dayOpen := na
        pmH := na
        pmL := na
        fiveH := na
        fiveL := na
        orbH := na
        orbL := na
        lastRTHClose := na

    if inPM
        pmH := na(pmH) ? high : math.max(pmH, high)
        pmL := na(pmL) ? low  : math.min(pmL, low)

    if inFirst5
        fiveH := na(fiveH) ? high : math.max(fiveH, high)
        fiveL := na(fiveL) ? low  : math.min(fiveL, low)

    if inOrbWin
        orbH := na(orbH) ? high : math.max(orbH, high)
        orbL := na(orbL) ? low  : math.min(orbL, low)

    if rthStart
        dayOpen := open

    if inRTH
        sessH := na(sessH) ? high : math.max(sessH, high)
        sessL := na(sessL) ? low  : math.min(sessL, low)
        lastRTHClose := close

    [pdi, mdi, adxVal] = ta.dmi(adxL, adxSm)
    avgVol = ta.sma(volume, rvolL)
    rvolVal = avgVol > 0 ? volume / avgVol : na
    outAdx  = calcAdx ? adxVal : na
    outRvol = calcRvol ? rvolVal : na
    outPdi  = calcAdx ? pdi : na
    outMdi  = calcAdx ? mdi : na
    outYt   = calcYt ? ytLbl : "—"

    [close, dayOpen, prevClose, pdh, pdl, pmH, pmL, fiveH, fiveL, orbH, orbL, outAdx, outRvol, outPdi, outMdi, outYt]

// Slot buffers — filled by global-scope request.security (never inside a loop)
var float[]  sl_now  = array.new<float>(18, na)
var float[]  sl_open = array.new<float>(18, na)
var float[]  sl_pc   = array.new<float>(18, na)
var float[]  sl_pdh  = array.new<float>(18, na)
var float[]  sl_pdl  = array.new<float>(18, na)
var float[]  sl_pmh  = array.new<float>(18, na)
var float[]  sl_pml  = array.new<float>(18, na)
var float[]  sl_fH   = array.new<float>(18, na)
var float[]  sl_fL   = array.new<float>(18, na)
var float[]  sl_oH   = array.new<float>(18, na)
var float[]  sl_oL   = array.new<float>(18, na)
var float[]  sl_adx  = array.new<float>(18, na)
var float[]  sl_rvol = array.new<float>(18, na)
var float[]  sl_pdi  = array.new<float>(18, na)
var float[]  sl_mdi  = array.new<float>(18, na)
var string[] sl_yt   = array.new<string>(18, "—")

f_putSlot(idx, cNow, sOpen, pdClose, pdh, pdl, pmH, pmL, fiveH, fiveL, orbH, orbL, adx, rvol, pdi, mdi, yt) =>
    array.set(sl_now, idx, cNow)
    array.set(sl_open, idx, sOpen)
    array.set(sl_pc, idx, pdClose)
    array.set(sl_pdh, idx, pdh)
    array.set(sl_pdl, idx, pdl)
    array.set(sl_pmh, idx, pmH)
    array.set(sl_pml, idx, pmL)
    array.set(sl_fH, idx, fiveH)
    array.set(sl_fL, idx, fiveL)
    array.set(sl_oH, idx, orbH)
    array.set(sl_oL, idx, orbL)
    array.set(sl_adx, idx, adx)
    array.set(sl_rvol, idx, rvol)
    array.set(sl_pdi, idx, pdi)
    array.set(sl_mdi, idx, mdi)
    array.set(sl_yt, idx, yt)

// =========================================================================
// INTRADAY — benchmark + 18 ticker slots at GLOBAL scope (fixes CW10003)
// =========================================================================
benchExt = ticker.modify(benchmarkSym, session = session.extended)
[qqqNow, qqqOpen, qqqPdClose, qqqPdh, qqqPdl, qqqPmH, qqqPmL, qqqFiveH, qqqFiveL, qqqOrbH, qqqOrbL, qqqAdx, qqqRvol, qqqPdi, qqqMdi, benchYTrend] =
     request.security(benchExt, timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend),
     lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off)

[c1, o1, pc1, pdh1, pdl1, pmh1, pml1, fH1, fL1, oH1, oL1, adx1, rv1, pdi1, mdi1, yt1] =
     request.security(ticker.modify(sym1, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(0, c1, o1, pc1, pdh1, pdl1, pmh1, pml1, fH1, fL1, oH1, oL1, adx1, rv1, pdi1, mdi1, yt1)
[c2, o2, pc2, pdh2, pdl2, pmh2, pml2, fH2, fL2, oH2, oL2, adx2, rv2, pdi2, mdi2, yt2] =
     request.security(ticker.modify(sym2, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(1, c2, o2, pc2, pdh2, pdl2, pmh2, pml2, fH2, fL2, oH2, oL2, adx2, rv2, pdi2, mdi2, yt2)
[c3, o3, pc3, pdh3, pdl3, pmh3, pml3, fH3, fL3, oH3, oL3, adx3, rv3, pdi3, mdi3, yt3] =
     request.security(ticker.modify(sym3, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(2, c3, o3, pc3, pdh3, pdl3, pmh3, pml3, fH3, fL3, oH3, oL3, adx3, rv3, pdi3, mdi3, yt3)
[c4, o4, pc4, pdh4, pdl4, pmh4, pml4, fH4, fL4, oH4, oL4, adx4, rv4, pdi4, mdi4, yt4] =
     request.security(ticker.modify(sym4, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(3, c4, o4, pc4, pdh4, pdl4, pmh4, pml4, fH4, fL4, oH4, oL4, adx4, rv4, pdi4, mdi4, yt4)
[c5, o5, pc5, pdh5, pdl5, pmh5, pml5, fH5, fL5, oH5, oL5, adx5, rv5, pdi5, mdi5, yt5] =
     request.security(ticker.modify(sym5, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(4, c5, o5, pc5, pdh5, pdl5, pmh5, pml5, fH5, fL5, oH5, oL5, adx5, rv5, pdi5, mdi5, yt5)
[c6, o6, pc6, pdh6, pdl6, pmh6, pml6, fH6, fL6, oH6, oL6, adx6, rv6, pdi6, mdi6, yt6] =
     request.security(ticker.modify(sym6, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(5, c6, o6, pc6, pdh6, pdl6, pmh6, pml6, fH6, fL6, oH6, oL6, adx6, rv6, pdi6, mdi6, yt6)
[c7, o7, pc7, pdh7, pdl7, pmh7, pml7, fH7, fL7, oH7, oL7, adx7, rv7, pdi7, mdi7, yt7] =
     request.security(ticker.modify(sym7, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(6, c7, o7, pc7, pdh7, pdl7, pmh7, pml7, fH7, fL7, oH7, oL7, adx7, rv7, pdi7, mdi7, yt7)
[c8, o8, pc8, pdh8, pdl8, pmh8, pml8, fH8, fL8, oH8, oL8, adx8, rv8, pdi8, mdi8, yt8] =
     request.security(ticker.modify(sym8, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(7, c8, o8, pc8, pdh8, pdl8, pmh8, pml8, fH8, fL8, oH8, oL8, adx8, rv8, pdi8, mdi8, yt8)
[c9, o9, pc9, pdh9, pdl9, pmh9, pml9, fH9, fL9, oH9, oL9, adx9, rv9, pdi9, mdi9, yt9] =
     request.security(ticker.modify(sym9, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(8, c9, o9, pc9, pdh9, pdl9, pmh9, pml9, fH9, fL9, oH9, oL9, adx9, rv9, pdi9, mdi9, yt9)
[c10, o10, pc10, pdh10, pdl10, pmh10, pml10, fH10, fL10, oH10, oL10, adx10, rv10, pdi10, mdi10, yt10] =
     request.security(ticker.modify(sym10, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(9, c10, o10, pc10, pdh10, pdl10, pmh10, pml10, fH10, fL10, oH10, oL10, adx10, rv10, pdi10, mdi10, yt10)
[c11, o11, pc11, pdh11, pdl11, pmh11, pml11, fH11, fL11, oH11, oL11, adx11, rv11, pdi11, mdi11, yt11] =
     request.security(ticker.modify(sym11, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(10, c11, o11, pc11, pdh11, pdl11, pmh11, pml11, fH11, fL11, oH11, oL11, adx11, rv11, pdi11, mdi11, yt11)
[c12, o12, pc12, pdh12, pdl12, pmh12, pml12, fH12, fL12, oH12, oL12, adx12, rv12, pdi12, mdi12, yt12] =
     request.security(ticker.modify(sym12, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(11, c12, o12, pc12, pdh12, pdl12, pmh12, pml12, fH12, fL12, oH12, oL12, adx12, rv12, pdi12, mdi12, yt12)
[c13, o13, pc13, pdh13, pdl13, pmh13, pml13, fH13, fL13, oH13, oL13, adx13, rv13, pdi13, mdi13, yt13] =
     request.security(ticker.modify(sym13, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(12, c13, o13, pc13, pdh13, pdl13, pmh13, pml13, fH13, fL13, oH13, oL13, adx13, rv13, pdi13, mdi13, yt13)
[c14, o14, pc14, pdh14, pdl14, pmh14, pml14, fH14, fL14, oH14, oL14, adx14, rv14, pdi14, mdi14, yt14] =
     request.security(ticker.modify(sym14, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(13, c14, o14, pc14, pdh14, pdl14, pmh14, pml14, fH14, fL14, oH14, oL14, adx14, rv14, pdi14, mdi14, yt14)
[c15, o15, pc15, pdh15, pdl15, pmh15, pml15, fH15, fL15, oH15, oL15, adx15, rv15, pdi15, mdi15, yt15] =
     request.security(ticker.modify(sym15, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(14, c15, o15, pc15, pdh15, pdl15, pmh15, pml15, fH15, fL15, oH15, oL15, adx15, rv15, pdi15, mdi15, yt15)
[c16, o16, pc16, pdh16, pdl16, pmh16, pml16, fH16, fL16, oH16, oL16, adx16, rv16, pdi16, mdi16, yt16] =
     request.security(ticker.modify(sym16, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(15, c16, o16, pc16, pdh16, pdl16, pmh16, pml16, fH16, fL16, oH16, oL16, adx16, rv16, pdi16, mdi16, yt16)
[c17, o17, pc17, pdh17, pdl17, pmh17, pml17, fH17, fL17, oH17, oL17, adx17, rv17, pdi17, mdi17, yt17] =
     request.security(ticker.modify(sym17, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(16, c17, o17, pc17, pdh17, pdl17, pmh17, pml17, fH17, fL17, oH17, oL17, adx17, rv17, pdi17, mdi17, yt17)
[c18, o18, pc18, pdh18, pdl18, pmh18, pml18, fH18, fL18, oH18, oL18, adx18, rv18, pdi18, mdi18, yt18] =
     request.security(ticker.modify(sym18, session = session.extended), timeframe.period, f_symbolBundle(adxLen, adxSmooth, rvolLen, needAdx, needRvol, needYTrend), lookahead = barmerge.lookahead_off, gaps = barmerge.gaps_off, ignore_invalid_symbol = true)
f_putSlot(17, c18, o18, pc18, pdh18, pdl18, pmh18, pml18, fH18, fL18, oH18, oL18, adx18, rv18, pdi18, mdi18, yt18)

qqqMov       = (na(qqqPdClose) or qqqPdClose == 0 or na(qqqNow)) ? na : (qqqNow / qqqPdClose - 1) * 100
qqqSinceOpen = (na(qqqOpen) or qqqOpen == 0 or na(qqqNow)) ? na : (qqqNow / qqqOpen - 1) * 100
qqqPrevD     = (na(qqqPdh) or na(qqqPdl) or na(qqqNow)) ? "—" : f_rangeLabel(qqqNow, qqqPdh, qqqPdl)
qqqPreMkt    = (na(qqqPmH) or na(qqqPmL) or na(qqqNow)) ? "—" : f_rangeLabel(qqqNow, qqqPmH, qqqPmL)
qqqOrb       = (na(qqqOrbH) or na(qqqOrbL) or na(qqqNow)) ? "—" : f_rangeLabel(qqqNow, qqqOrbH, qqqOrbL)

var float[]  movArr       = array.new<float>()
var float[]  sinceOpenArr = array.new<float>()
var string[] prevDArr     = array.new<string>()
var string[] preMktArr    = array.new<string>()
var string[] orbArr       = array.new<string>()
var float[]  pdhArr       = array.new<float>()
var float[]  pdlArr       = array.new<float>()
var float[]  pmhArr       = array.new<float>()
var float[]  pmlArr       = array.new<float>()
var float[]  fiveHArr     = array.new<float>()
var float[]  fiveLArr     = array.new<float>()
var float[]  orbHArr      = array.new<float>()
var float[]  orbLArr      = array.new<float>()
var float[]  adxArr       = array.new<float>()
var float[]  rvolArr      = array.new<float>()
var float[]  pdiArr       = array.new<float>()
var float[]  mdiArr       = array.new<float>()
var float[]  nowArr       = array.new<float>()
var string[] yTrendArr    = array.new<string>()
array.clear(movArr)
array.clear(sinceOpenArr)
array.clear(prevDArr)
array.clear(preMktArr)
array.clear(orbArr)
array.clear(pdhArr)
array.clear(pdlArr)
array.clear(pmhArr)
array.clear(pmlArr)
array.clear(fiveHArr)
array.clear(fiveLArr)
array.clear(orbHArr)
array.clear(orbLArr)
array.clear(adxArr)
array.clear(rvolArr)
array.clear(pdiArr)
array.clear(mdiArr)
array.clear(nowArr)
array.clear(yTrendArr)

// Assemble enabled rows from slot buffers (no request.security / f_symbolBundle here)
for i = 0 to n - 1
    slot     = array.get(slotIdxArr, i)
    cNow     = array.get(sl_now, slot)
    sOpen    = array.get(sl_open, slot)
    pdClose  = array.get(sl_pc, slot)
    pdh      = array.get(sl_pdh, slot)
    pdl      = array.get(sl_pdl, slot)
    pmH      = array.get(sl_pmh, slot)
    pmL      = array.get(sl_pml, slot)
    fiveH    = array.get(sl_fH, slot)
    fiveL    = array.get(sl_fL, slot)
    orbH     = array.get(sl_oH, slot)
    orbL     = array.get(sl_oL, slot)
    symAdx   = array.get(sl_adx, slot)
    symRvol  = array.get(sl_rvol, slot)
    symPdi   = array.get(sl_pdi, slot)
    symMdi   = array.get(sl_mdi, slot)
    symYt    = array.get(sl_yt, slot)

    symMov       = (na(pdClose) or pdClose == 0 or na(cNow)) ? na : (cNow / pdClose - 1) * 100
    symSinceOpen = (na(sOpen) or sOpen == 0 or na(cNow)) ? na : (cNow / sOpen - 1) * 100
    prevDLabel   = (na(pdh) or na(pdl) or na(cNow)) ? "—" : f_rangeLabel(cNow, pdh, pdl)
    preMktLabel  = (na(pmH) or na(pmL) or na(cNow)) ? "—" : f_rangeLabel(cNow, pmH, pmL)
    orbLabel     = (na(orbH) or na(orbL) or na(cNow)) ? "—" : f_rangeLabel(cNow, orbH, orbL)

    array.push(movArr, symMov)
    array.push(sinceOpenArr, symSinceOpen)
    array.push(prevDArr, prevDLabel)
    array.push(preMktArr, preMktLabel)
    array.push(orbArr, orbLabel)
    array.push(pdhArr, pdh)
    array.push(pdlArr, pdl)
    array.push(pmhArr, pmH)
    array.push(pmlArr, pmL)
    array.push(fiveHArr, fiveH)
    array.push(fiveLArr, fiveL)
    array.push(orbHArr, orbH)
    array.push(orbLArr, orbL)
    array.push(adxArr, symAdx)
    array.push(rvolArr, symRvol)
    array.push(pdiArr, symPdi)
    array.push(mdiArr, symMdi)
    array.push(nowArr, cNow)
    array.push(yTrendArr, symYt)

// =========================================================================
// ADX ALERTS — watchlist symbols above threshold during alert period
// =========================================================================
bool inAlertWindow = not na(time(timeframe.period, alertSession, sessionTz))

if adxAlertEnabled and inAlertWindow and barstate.isconfirmed and n > 0
    for i = 0 to n - 1
        float alertAdx = array.get(adxArr, i)
        if not na(alertAdx) and alertAdx >= adxThreshold
            alert(f_shortSymbol(array.get(symbolList, i)) + " ADX " + str.tostring(alertAdx, "#.#") +
                 " ≥ " + str.tostring(adxThreshold, "#.#"), alert.freq_once_per_bar_close)

// =========================================================================
// TABLE STYLE
// =========================================================================
tblPos = posInput == "Top Right" ? position.top_right :
         posInput == "Top Left"  ? position.top_left  :
         posInput == "Bottom Right" ? position.bottom_right : position.bottom_left

tblSize = textSize == "Tiny" ? size.tiny :
          textSize == "Small" ? size.small :
          textSize == "Large" ? size.large : size.normal
useCompactLabels = textSize == "Tiny" or textSize == "Small"

f_numTextColor(v) =>
    na(v) ? txtMain : v > 0.05 ? posColor : v < -0.05 ? negColor : txtMain

f_statusColor(label) =>
    label == "Above" ? color.new(color.green, 0) : label == "Below" ? color.new(color.red, 0) : neutralBg

// Compact display when Tiny/Small: Above→A, Below→B, Inside→I, Long→L, Short→S, Flat→F
f_compactLabel(label) =>
    not useCompactLabels ? label :
         label == "Above"  ? "A" :
         label == "Below"  ? "B" :
         label == "Inside" ? "I" :
         label == "Long"   ? "L" :
         label == "Short"  ? "S" :
         label == "Flat"   ? "F" : label

f_headerCell(tbl, col, label) =>
    table.cell(tbl, col, 0, label, bgcolor = bgHeader, text_color = txtMain, text_size = tblSize)

f_priceCell(tbl, col, row, val, rowBg) =>
    table.cell(tbl, col, row, f_fmtPrice(val), bgcolor = rowBg, text_color = txtMain, text_size = tblSize)

f_pctCell(tbl, col, row, val, rowBg) =>
    table.cell(tbl, col, row, na(val) ? "—" : str.tostring(val, "#.#") + "%", bgcolor = rowBg,
         text_color = f_numTextColor(val), text_size = tblSize)

f_textCell(tbl, col, row, txt, rowBg, txtCol) =>
    table.cell(tbl, col, row, txt, bgcolor = rowBg, text_color = txtCol, text_size = tblSize)

f_statusCell(tbl, col, row, label) =>
    table.cell(tbl, col, row, f_compactLabel(label), bgcolor = f_statusColor(label), text_color = color.white, text_size = tblSize)

f_rangeCell(tbl, col, row, label, useColor, rowBg) =>
    if useColor and label != "—"
        f_statusCell(tbl, col, row, label)
    else
        f_textCell(tbl, col, row, f_compactLabel(label), rowBg, txtMain)

f_trendInfo(prevD, preMkt, spread) =>
    int bullPts = (prevD == "Above" ? 1 : 0) + (preMkt == "Above" ? 1 : 0) + (spread > 0.05 ? 1 : 0)
    int bearPts = (prevD == "Below" ? 1 : 0) + (preMkt == "Below" ? 1 : 0) + (spread < -0.05 ? 1 : 0)
    string lbl = bullPts == 3 ? "Long" : bearPts == 3 ? "Short" :
         bullPts >= 2 and bullPts > bearPts ? "Long" :
         bearPts >= 2 and bearPts > bullPts ? "Short" : "Flat"
    bool strong = bullPts == 3 or bearPts == 3
    [lbl, strong]

f_trendBg(label, strong, rowBg) =>
    label == "Long"  ? (strong ? color.new(color.green, 0) : warnBg) :
     label == "Short" ? (strong ? color.new(color.red, 0) : warnBg) :
     rowBg

f_trendCell(tbl, col, row, prevD, preMkt, spread, rowBg) =>
    [lbl, strong] = f_trendInfo(prevD, preMkt, spread)
    bg  = f_trendBg(lbl, strong, rowBg)
    tc  = lbl == "Flat" ? txtMain : color.white
    table.cell(tbl, col, row, f_compactLabel(lbl), bgcolor = bg, text_color = tc, text_size = tblSize)

f_adxCell(tbl, col, row, adx, pdi, mdi, rowBg) =>
    bg = colorADX ? f_adxBg(adx, pdi, mdi) : rowBg
    tc = colorADX ? color.white : txtMain
    table.cell(tbl, col, row, f_fmtAdx(adx, pdi, mdi), bgcolor = bg, text_color = tc, text_size = tblSize)

f_rvolCell(tbl, col, row, v, rowBg) =>
    bg = colorRVOL ? f_rvolBg(v) : rowBg
    tc = colorRVOL ? color.white : txtMain
    table.cell(tbl, col, row, f_fmtRvol(v), bgcolor = bg, text_color = tc, text_size = tblSize)

f_rowSpread(idx) =>
    array.get(sinceOpenArr, idx) - (na(qqqSinceOpen) ? 0.0 : qqqSinceOpen)

f_movSpread(idx) =>
    array.get(movArr, idx) - (na(qqqMov) ? 0.0 : qqqMov)

// Primary: Open % or RS after RTH open. Premarket (no open yet): fall back to Mov / Mov vs bench.
f_sortKey(idx) =>
    float so = array.get(sinceOpenArr, idx)
    if not na(so)
        sortMetric == "Open % since RTH open" ? so : f_rowSpread(idx)
    else
        sortMetric == "Open % since RTH open" ? array.get(movArr, idx) : f_movSpread(idx)

f_rangeBullPts(idx) =>
    int pts = 0
    if array.get(prevDArr, idx) == "Above"
        pts += 1
    if array.get(preMktArr, idx) == "Above"
        pts += 1
    pts

f_sortBetter(a, b) =>
    float ka = f_sortKey(a)
    float kb = f_sortKey(b)
    if scoreWithRanges
        int ra = f_rangeBullPts(a)
        int rb = f_rangeBullPts(b)
        rb != ra ? rb > ra : nz(kb, -1e10) > nz(ka, -1e10)
    else
        nz(kb, -1e10) > nz(ka, -1e10)

// =========================================================================
// TABLE
// =========================================================================
bool tableDraw = barstate.islastconfirmedhistory or barstate.islast

if tableDraw and n > 0 and totalCols > 0
    var table rsTable = na
    var int[] order = array.new<int>()
    array.clear(order)
    for i = 0 to n - 1
        bool hasOpen  = not na(array.get(sinceOpenArr, i))
        bool hasPrice = not na(array.get(nowArr, i))
        bool rowReady = hasOpen or (showBeforeRthOpen and hasPrice)
        if rowReady
            bool adxOk  = not adxFilterEnabled or (not na(array.get(adxArr, i)) and array.get(adxArr, i) > adxFilterAbove)
            bool prevOk = not prevDFilterEnabled or array.get(prevDArr, i) == prevDFilter
            bool preOk  = not preMktFilterEnabled or array.get(preMktArr, i) == preMktFilter
            bool orbOk  = not orbFilterEnabled or array.get(orbArr, i) == orbFilter
            if adxOk and prevOk and preOk and orbOk
                array.push(order, i)

    rows = array.size(order)
    int benchRow  = showBenchRow ? 1 : na
    int dataStart = showBenchRow ? 2 : 1

    if sortByStrength and rows > 1
        for i = 0 to rows - 2
            for j = 0 to rows - 2 - i
                idxA = array.get(order, j)
                idxB = array.get(order, j + 1)
                if f_sortBetter(idxA, idxB)
                    array.set(order, j, idxB)
                    array.set(order, j + 1, idxA)

    if rows > 0
        if not na(rsTable)
            table.delete(rsTable)
        rsTable := table.new(position = tblPos, columns = totalCols, rows = rows + dataStart,
             border_width = 1, border_color = color.gray, frame_color = color.gray, frame_width = 1)

        col = 0
        f_headerCell(rsTable, col, "Sym")
        col += 1
        if showMov
            f_headerCell(rsTable, col, "Mov")
            col += 1
        if showOpen
            f_headerCell(rsTable, col, "Open")
            col += 1
        if showBenchCol
            f_headerCell(rsTable, col, f_shortSymbol(benchmarkSym))
            col += 1
        if showRS
            f_headerCell(rsTable, col, "RS")
            col += 1
        if showPrevD
            f_headerCell(rsTable, col, "PrevD")
            col += 1
        if showPreMkt
            f_headerCell(rsTable, col, "PreMkt")
            col += 1
        if showOrb
            f_headerCell(rsTable, col, orbHeader)
            col += 1
        if showTrend
            f_headerCell(rsTable, col, "Trend")
            col += 1
        if showYTrend
            f_headerCell(rsTable, col, "YTrend")
            col += 1
        if showADX
            f_headerCell(rsTable, col, "ADX")
            col += 1
        if showRVOL
            f_headerCell(rsTable, col, "RVOL")
            col += 1
        if showPDH
            f_headerCell(rsTable, col, "PDH")
            col += 1
        if showPDL
            f_headerCell(rsTable, col, "PDL")
            col += 1
        if showPMH
            f_headerCell(rsTable, col, "PMH")
            col += 1
        if showPML
            f_headerCell(rsTable, col, "PML")
            col += 1
        if show5mH
            f_headerCell(rsTable, col, "5mH")
            col += 1
        if show5mL
            f_headerCell(rsTable, col, "5mL")

        if showBenchRow
            col := 0
            f_textCell(rsTable, col, benchRow, f_shortSymbol(benchmarkSym), bgBenchRow, txtMain)
            col += 1
            if showMov
                f_pctCell(rsTable, col, benchRow, qqqMov, bgBenchRow)
                col += 1
            if showOpen
                f_pctCell(rsTable, col, benchRow, qqqSinceOpen, bgBenchRow)
                col += 1
            if showBenchCol
                f_pctCell(rsTable, col, benchRow, qqqSinceOpen, bgBenchRow)
                col += 1
            if showRS
                f_textCell(rsTable, col, benchRow, "—", bgBenchRow, txtMain)
                col += 1
            if showPrevD
                f_rangeCell(rsTable, col, benchRow, qqqPrevD, colorPrevD, bgBenchRow)
                col += 1
            if showPreMkt
                f_rangeCell(rsTable, col, benchRow, qqqPreMkt, colorPreMkt, bgBenchRow)
                col += 1
            if showOrb
                f_rangeCell(rsTable, col, benchRow, qqqOrb, colorOrb, bgBenchRow)
                col += 1
            if showTrend
                f_trendCell(rsTable, col, benchRow, qqqPrevD, qqqPreMkt, 0.0, bgBenchRow)
                col += 1
            if showYTrend
                f_statusCell(rsTable, col, benchRow, benchYTrend)
                col += 1
            if showADX
                f_adxCell(rsTable, col, benchRow, qqqAdx, qqqPdi, qqqMdi, bgBenchRow)
                col += 1
            if showRVOL
                f_rvolCell(rsTable, col, benchRow, qqqRvol, bgBenchRow)
                col += 1
            if showPDH
                f_priceCell(rsTable, col, benchRow, qqqPdh, bgBenchRow)
                col += 1
            if showPDL
                f_priceCell(rsTable, col, benchRow, qqqPdl, bgBenchRow)
                col += 1
            if showPMH
                f_priceCell(rsTable, col, benchRow, qqqPmH, bgBenchRow)
                col += 1
            if showPML
                f_priceCell(rsTable, col, benchRow, qqqPmL, bgBenchRow)
                col += 1
            if show5mH
                f_priceCell(rsTable, col, benchRow, qqqFiveH, bgBenchRow)
                col += 1
            if show5mL
                f_priceCell(rsTable, col, benchRow, qqqFiveL, bgBenchRow)

        for k = 0 to rows - 1
            row = k + dataStart
            idx = array.get(order, k)
            s        = array.get(symbolList, idx)
            movRet   = array.get(movArr, idx)
            sOpenRet = array.get(sinceOpenArr, idx)
            cNowR    = array.get(nowArr, idx)
            pdhVal   = array.get(pdhArr, idx)
            pdlVal   = array.get(pdlArr, idx)
            pmhVal   = array.get(pmhArr, idx)
            pmlVal   = array.get(pmlArr, idx)
            fiveHVal = array.get(fiveHArr, idx)
            fiveLVal = array.get(fiveLArr, idx)
            orbHVal  = array.get(orbHArr, idx)
            orbLVal  = array.get(orbLArr, idx)
            adxVal   = array.get(adxArr, idx)
            rvolVal  = array.get(rvolArr, idx)
            pdiVal   = array.get(pdiArr, idx)
            mdiVal   = array.get(mdiArr, idx)
            yTrendVal = needYTrend ? array.get(yTrendArr, idx) : "—"

            prevD  = (na(pdhVal) or na(pdlVal) or na(cNowR)) ? "—" : f_rangeLabel(cNowR, pdhVal, pdlVal)
            preMkt = (na(pmhVal) or na(pmlVal) or na(cNowR)) ? "—" : f_rangeLabel(cNowR, pmhVal, pmlVal)
            orbLbl = (na(orbHVal) or na(orbLVal) or na(cNowR)) ? "—" : f_rangeLabel(cNowR, orbHVal, orbLVal)

            spread = f_rowSpread(idx)
            rsSym   = spread > 0.05 ? "▲" : spread < -0.05 ? "▼" : "•"
            rsColor = spread > 0.05 ? color.new(color.green, 0) : spread < -0.05 ? color.new(color.red, 0) : neutralBg

            col := 0
            f_textCell(rsTable, col, row, f_shortSymbol(s), bgMain, txtMain)
            col += 1
            if showMov
                f_pctCell(rsTable, col, row, movRet, bgMain)
                col += 1
            if showOpen
                f_pctCell(rsTable, col, row, sOpenRet, bgMain)
                col += 1
            if showBenchCol
                f_pctCell(rsTable, col, row, qqqSinceOpen, bgMain)
                col += 1
            if showRS
                table.cell(rsTable, col, row, rsSym, bgcolor = rsColor, text_color = color.white, text_size = tblSize)
                col += 1
            if showPrevD
                f_rangeCell(rsTable, col, row, prevD, colorPrevD, bgMain)
                col += 1
            if showPreMkt
                f_rangeCell(rsTable, col, row, preMkt, colorPreMkt, bgMain)
                col += 1
            if showOrb
                f_rangeCell(rsTable, col, row, orbLbl, colorOrb, bgMain)
                col += 1
            if showTrend
                f_trendCell(rsTable, col, row, prevD, preMkt, spread, bgMain)
                col += 1
            if showYTrend
                f_statusCell(rsTable, col, row, yTrendVal)
                col += 1
            if showADX
                f_adxCell(rsTable, col, row, adxVal, pdiVal, mdiVal, bgMain)
                col += 1
            if showRVOL
                f_rvolCell(rsTable, col, row, rvolVal, bgMain)
                col += 1
            if showPDH
                f_priceCell(rsTable, col, row, pdhVal, bgMain)
                col += 1
            if showPDL
                f_priceCell(rsTable, col, row, pdlVal, bgMain)
                col += 1
            if showPMH
                f_priceCell(rsTable, col, row, pmhVal, bgMain)
                col += 1
            if showPML
                f_priceCell(rsTable, col, row, pmlVal, bgMain)
                col += 1
            if show5mH
                f_priceCell(rsTable, col, row, fiveHVal, bgMain)
                col += 1
            if show5mL
                f_priceCell(rsTable, col, row, fiveLVal, bgMain)
