//@version=6
// daily-trading-levels v1.0.0
// Path: indicators/daily-trading-levels/scripts/v1/daily_trading_levels.pine
//
// Marks PDH/PDL, PMH/PML, ORB (1st candle / 5m / 15m / 30m / 1H), Gap, Intraday H/L,
// previous week + previous month H/L as right-edge marks,
// optional Session VWAP, and up to 8 configurable EMAs.
//
// Daily levels are plot() series on the bars (they scroll and zoom with price),
// shown only inside the levels window (default 04:00-16:00 ET) and, by default,
// only for the most recent day. Weekly / monthly levels are short line.new()
// marks ending at the last bar, so they never stretch back to the candle that set them.
//
// Plot budget (Pine RE10140 limit is 64 plot counts):
//   A plot() with an input.color counts 2; with a const color counts 1;
//   fill() counts 1 only when its color is a series. line.new / label.new count 0.
//   17 daily levels x2 = 34, gap 2 x2 = 4, VWAP 1 x2 = 2, VWAP bands 4 x1 = 4,
//   EMAs 8 x2 = 16, fill 0  ->  60 of 64.
//   Adding another input-colored plot costs 2. Keep the total at or under 64.

indicator("Daily Trading Levels", shorttitle = "DTL", overlay = true, max_boxes_count = 50, max_labels_count = 100, max_lines_count = 100)

// =========================================================================
// INPUTS — General
// =========================================================================
string GRP_GEN = "General"
string sessionTz = input.string("America/New_York", "Timezone", group = GRP_GEN, display = display.none)
bool showLabels = input.bool(true, "Show level labels", group = GRP_GEN)
string labelSizeIn = input.string("Small", "Label size", options = ["Tiny", "Small", "Normal", "Large"], group = GRP_GEN, display = display.none)
string levelDaysMode = input.string("Last day only", "Show daily levels on", options = ["Last day only", "All days"], group = GRP_GEN, display = display.none,
     tooltip = "Last day only: PD / PM / ORB / intraday levels and the gap appear only for the most recent trading day. Scrolling back shows clean candles. All days: every day shows its own levels.")
string levelSession = input.session("0400-1600", "Daily levels window (ET)", group = GRP_GEN, display = display.none,
     tooltip = "Daily levels are drawn only inside this window. Nothing is drawn outside it.")
int markBars = input.int(20, "Weekly / monthly mark length (bars)", minval = 2, maxval = 200, group = GRP_GEN, display = display.none,
     tooltip = "Previous week / month levels are short marks ending at the latest bar, this many bars long.")

labelSize = labelSizeIn == "Tiny" ? size.tiny : labelSizeIn == "Small" ? size.small : labelSizeIn == "Large" ? size.large : size.normal

// =========================================================================
// INPUTS — Previous Day
// =========================================================================
string GRP_PD = "Previous Day (PDH / PDL / PDC)"
bool showPdh = input.bool(true, "Show PDH", group = GRP_PD, inline = "pdh")
color colPdh = input.color(color.new(#f5a623, 0), "", group = GRP_PD, inline = "pdh")
string styPdh = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = GRP_PD, inline = "pdh", display = display.none)
int wPdh = input.int(2, "", minval = 1, maxval = 4, group = GRP_PD, inline = "pdh", display = display.none)

bool showPdl = input.bool(true, "Show PDL", group = GRP_PD, inline = "pdl")
string styPdl = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = GRP_PD, inline = "pdl", display = display.none)
int wPdl = input.int(2, "", minval = 1, maxval = 4, group = GRP_PD, inline = "pdl", display = display.none)

bool showPdc = input.bool(false, "Show PDC (prior RTH close)", group = GRP_PD, inline = "pdc")
color colPdc = input.color(color.new(#787b86, 0), "", group = GRP_PD, inline = "pdc")
string styPdc = input.string("Dashed", "", options = ["Solid", "Dashed", "Dotted"], group = GRP_PD, inline = "pdc", display = display.none)
int wPdc = input.int(2, "", minval = 1, maxval = 4, group = GRP_PD, inline = "pdc", display = display.none)

// =========================================================================
// INPUTS — Previous Week (right-edge marks)
// =========================================================================
string GRP_PW = "Previous Week (PWH / PWL) — mark at latest bar"
bool showPwh = input.bool(true, "Show PWH", group = GRP_PW, inline = "pwh")
color colPwh = input.color(color.new(#26c6da, 0), "", group = GRP_PW, inline = "pwh")
string styPwh = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = GRP_PW, inline = "pwh", display = display.none)
int wPwh = input.int(2, "", minval = 1, maxval = 4, group = GRP_PW, inline = "pwh", display = display.none)

bool showPwl = input.bool(true, "Show PWL", group = GRP_PW, inline = "pwl")
string styPwl = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = GRP_PW, inline = "pwl", display = display.none)
int wPwl = input.int(2, "", minval = 1, maxval = 4, group = GRP_PW, inline = "pwl", display = display.none)

// =========================================================================
