int wIdL = input.int(2, "", minval = 1, maxval = 4, group = GRP_ID, inline = "idl", display = display.none)

string idSessionMode = input.string("RTH only", "Intraday range session", options = ["RTH only", "Premarket + RTH"], group = GRP_ID, display = display.none)

// =========================================================================
// INPUTS — Gap
// =========================================================================
string GRP_GAP = "Gap (PDC → Open)"
bool showGap = input.bool(true, "Show gap box", group = GRP_GAP)
color gapBorder = input.color(color.new(#787b86, 0), "Gap border color", group = GRP_GAP)
color gapFill = input.color(color.new(#787b86, 85), "Gap fill color", group = GRP_GAP)
int gapBorderWidth = input.int(3, "Gap border width", minval = 1, maxval = 4, group = GRP_GAP, display = display.none)
bool showGapLabel = input.bool(true, "Show gap label", group = GRP_GAP)

// =========================================================================
// INPUTS — VWAP
// =========================================================================
string GRP_VWAP = "VWAP"
bool showVwap = input.bool(true, "Show VWAP", group = GRP_VWAP, inline = "vw")
color colVwap = input.color(color.new(#ef5350, 0), "", group = GRP_VWAP, inline = "vw")
int wVwap = input.int(2, "", minval = 1, maxval = 4, group = GRP_VWAP, inline = "vw", display = display.none)
string vwapAnchor = input.string("Session (incl. premarket)", "VWAP anchor", options = ["RTH open", "Session (incl. premarket)"], group = GRP_VWAP, display = display.none)
bool showVwapBands = input.bool(false, "Show VWAP ±1 / ±2 bands", group = GRP_VWAP,
     tooltip = "Band color is fixed here to stay under Pine's 64-plot budget. Recolor the bands in the Style tab.")
// Constant color on purpose: an input color makes each band plot count double toward the 64-plot limit.
color colVwapBand = color.new(#ffeb3b, 60)

// =========================================================================
// INPUTS — EMAs (up to 8)
// =========================================================================
string GRP_EMA = "EMAs"
bool showEma1 = input.bool(true, "EMA 1", group = GRP_EMA, inline = "e1")
int lenEma1 = input.int(9, "", minval = 1, group = GRP_EMA, inline = "e1", display = display.none)
color colEma1 = input.color(color.new(#26a69a, 0), "", group = GRP_EMA, inline = "e1")
int wEma1 = input.int(2, "", minval = 1, maxval = 4, group = GRP_EMA, inline = "e1", display = display.none)

bool showEma2 = input.bool(true, "EMA 2", group = GRP_EMA, inline = "e2")
int lenEma2 = input.int(20, "", minval = 1, group = GRP_EMA, inline = "e2", display = display.none)
color colEma2 = input.color(color.new(#ff9800, 0), "", group = GRP_EMA, inline = "e2")
int wEma2 = input.int(2, "", minval = 1, maxval = 4, group = GRP_EMA, inline = "e2", display = display.none)

bool showEma3 = input.bool(true, "EMA 3", group = GRP_EMA, inline = "e3")
int lenEma3 = input.int(50, "", minval = 1, group = GRP_EMA, inline = "e3", display = display.none)
