bool showPml = input.bool(true, "Show PML", group = GRP_PM, inline = "pml")
string styPml = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], group = GRP_PM, inline = "pml", display = display.none)
int wPml = input.int(2, "", minval = 1, maxval = 4, group = GRP_PM, inline = "pml", display = display.none)

// =========================================================================
