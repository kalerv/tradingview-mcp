//@version=6
// QQQ 9:31 range breakout v1.0.0
// 1-minute chart. The 09:30–09:31 ET candle sets the range.
// Break above high = long (call proxy). Break below low = short (put proxy).
// TradingView cannot buy the option; this holds 2 QQQ shares instead.
// Exit at +$5 in favor, or at the RTH close of the 5th session (entry day = day 1).

strategy(
     title                   = "QQQ 9:31 Range Breakout",
     shorttitle              = "QQQ 931",
     overlay                 = true,
     pyramiding              = 0,
     default_qty_type        = strategy.fixed,
     default_qty_value       = 2,
     initial_capital         = 25000,
     commission_type         = strategy.commission.cash_per_order,
     commission_value        = 0,
     slippage                = 1,
     calc_on_order_fills     = true,
     process_orders_on_close = false)

string GRP_SESSION = "Session"
string GRP_TRADE   = "Trade"
string GRP_VISUAL  = "Visuals"

string sessionTz   = input.string("America/New_York", "Timezone", group = GRP_SESSION)
int holdDays       = input.int(5, "Days to hold", minval = 1, maxval = 5, group = GRP_SESSION,
     tooltip = "1 to 5 regular sessions. Entry session counts as day 1. If the favorable target has not hit, the position closes on the last RTH minute of the selected day.")
int shares         = input.int(2, "QQQ shares", minval = 1, maxval = 100, group = GRP_TRADE,
     tooltip = "Long shares stand in for a 5-day QQQ call (ATM or 1 strike out). Short shares stand in for the put.")
float profitDollars = input.float(5.0, "Favorable exit ($)", minval = 0.01, step = 0.01, group = GRP_TRADE,
     tooltip = "Long exits at entry + this amount. Short exits at entry − this amount. Example: short from 605 covers at 600.")
bool useStopLoss   = input.bool(false, "Use stop loss", group = GRP_TRADE,
     tooltip = "When on, exit if price moves this many dollars against the fill. When off, a losing trade is held until the day limit.")
float stopDollars  = input.float(5.0, "Stop loss ($)", minval = 0.01, step = 0.01, group = GRP_TRADE,
     tooltip = "Long stops at entry − this amount. Short stops at entry + this amount. Used only when Use stop loss is on.")

bool showRange = input.bool(true, "Show 9:31 high / low", group = GRP_VISUAL)
bool showTable = input.bool(true, "Show status table", group = GRP_VISUAL)

bool isOneMinute = timeframe.isminutes and timeframe.multiplier == 1
bool inRth = not na(time(timeframe.period, "0930-1600:23456", sessionTz))
bool isOpenMinute = not na(time(timeframe.period, "0930-0931:23456", sessionTz))
bool isLastRthMinute = not na(time(timeframe.period, "1559-1600:23456", sessionTz))
bool rthStart = inRth and not inRth[1]

var float rangeHigh = na
var float rangeLow = na
var bool rangeReady = false
var bool skipToday = false
var int sessionsHeld = 0

if rthStart
    rangeHigh := na
    rangeLow := na
    rangeReady := false
    skipToday := strategy.position_size != 0

if isOneMinute and isOpenMinute and barstate.isconfirmed and not skipToday
    rangeHigh := high
    rangeLow := low
    rangeReady := rangeHigh > rangeLow

bool flat = strategy.position_size == 0
bool canEnter = isOneMinute and rangeReady and flat and inRth and not isOpenMinute and not skipToday

if canEnter
    strategy.entry("QQQ Call", strategy.long, qty = shares, stop = rangeHigh, oca_name = "qqq931", oca_type = strategy.oca.cancel)
    strategy.entry("QQQ Put", strategy.short, qty = shares, stop = rangeLow, oca_name = "qqq931", oca_type = strategy.oca.cancel)

if flat and not canEnter
    strategy.cancel("QQQ Call")
    strategy.cancel("QQQ Put")

if flat
    sessionsHeld := 0
else if strategy.position_size[1] == 0
    sessionsHeld := 1
else if rthStart
    sessionsHeld += 1

float longTarget = strategy.position_avg_price + profitDollars
float shortTarget = strategy.position_avg_price - profitDollars
float longStop = strategy.position_avg_price - stopDollars
float shortStop = strategy.position_avg_price + stopDollars

if strategy.position_size > 0
    strategy.exit("Call target", from_entry = "QQQ Call", limit = longTarget, stop = useStopLoss ? longStop : na)
if strategy.position_size < 0
    strategy.exit("Put target", from_entry = "QQQ Put", limit = shortTarget, stop = useStopLoss ? shortStop : na)

if strategy.position_size != 0 and sessionsHeld >= holdDays and isLastRthMinute
    strategy.close("QQQ Call", comment = "5-day")
    strategy.close("QQQ Put", comment = "5-day")

plot(showRange and rangeReady ? rangeHigh : na, "9:31 High", color = color.new(color.teal, 0), style = plot.style_linebr, linewidth = 2)
plot(showRange and rangeReady ? rangeLow : na, "9:31 Low", color = color.new(color.orange, 0), style = plot.style_linebr, linewidth = 2)
bgcolor(isOpenMinute ? color.new(color.blue, 88) : na, title = "9:30–9:31")

var table status = table.new(position.top_right, 2, 5, border_width = 1)
if showTable and barstate.islast
    string side = strategy.position_size > 0 ? "Long (call)" : strategy.position_size < 0 ? "Short (put)" : "Flat"
    string held = strategy.position_size == 0 ? "—" : str.tostring(sessionsHeld) + " / " + str.tostring(holdDays)
    table.cell(status, 0, 0, "QQQ 9:31", bgcolor = color.new(#1a3a5c, 0), text_color = color.white)
    table.cell(status, 1, 0, isOneMinute ? "1m" : "Use 1m", bgcolor = color.new(#1a3a5c, 0), text_color = isOneMinute ? color.white : color.orange)
    table.cell(status, 0, 1, "High", text_color = color.white, bgcolor = color.black)
    table.cell(status, 1, 1, na(rangeHigh) ? "—" : str.tostring(rangeHigh, "#.##"), text_color = color.white, bgcolor = color.black)
    table.cell(status, 0, 2, "Low", text_color = color.white, bgcolor = color.black)
    table.cell(status, 1, 2, na(rangeLow) ? "—" : str.tostring(rangeLow, "#.##"), text_color = color.white, bgcolor = color.black)
    table.cell(status, 0, 3, "Position", text_color = color.white, bgcolor = color.black)
    table.cell(status, 1, 3, side, text_color = color.white, bgcolor = color.black)
    table.cell(status, 0, 4, "Sessions", text_color = color.white, bgcolor = color.black)
    table.cell(status, 1, 4, held, text_color = color.white, bgcolor = color.black)

if not isOneMinute and barstate.islast
    label.new(bar_index, high, "QQQ 9:31 strategy requires a 1-minute chart", style = label.style_label_down, textcolor = color.white, color = color.red)
